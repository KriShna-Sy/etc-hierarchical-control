<?xml version="1.0"?>
<!--
  FWLD — swarm_description
  ROS2 Jazzy + Gazebo Harmonic

  MOTION FIX: Using gz-sim-diff-drive-system (Gazebo native plugin) instead
  of gz_ros2_control. This bypasses the gz_ros2_control bridge that was
  silently dropping velocity commands.

  cmd_vel topic:  /diff_drive_controller/cmd_vel  (Twist, bridged from Gz)
  odom topic:     /diff_drive_controller/odom      (bridged from Gz)

  IMPORTANT — add these bridges to gazebo.launch.py:
    /model/fwld/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist
    /model/fwld/odometry@nav_msgs/msg/Odometry[gz.msgs.Odometry
  OR use the topic names set in the plugin below:
    cmd_vel_topic = /diff_drive_controller/cmd_vel
    odom_topic    = /diff_drive_controller/odom
-->
<robot name="fwld" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================== -->
  <!--  MACROS                                                      -->
  <!-- =========================================================== -->

  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.036" length="0.016"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.260"/>
        <inertia
          ixx="8.468e-05" iyy="1.688e-04" izz="8.468e-05"
          ixy="0.0"       iyz="0.0"       ixz="0.0"/>
      </inertial>
      <collision>
        <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.036" length="0.016"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <material>Gazebo/Black</material>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1e6</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="side_panel" params="name">
    <link name="${name}">
      <visual>
        <geometry><box size="0.218 0.034 0.002"/></geometry>
        <material name="panel_blue">
          <color rgba="0.1 0.3 0.8 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="4.833e-06" ixy="0" ixz="0"
                 iyy="1.980e-04" iyz="0" izz="2.027e-04"/>
      </inertial>
      <collision>
        <geometry><box size="0.218 0.034 0.002"/></geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <!-- =========================================================== -->
  <!--  LINKS                                                       -->
  <!-- =========================================================== -->

  <!-- base_footprint = massless root (required by KDL/robot_state_publisher) -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.218 0.147 0.002"/></geometry>
      <material name="chassis_red">
        <color rgba="0.85 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="9.005e-04" ixy="0" ixz="0"
               iyy="1.980e-03" iyz="0" izz="2.881e-03"/>
    </inertial>
    <collision>
      <geometry><box size="0.218 0.147 0.002"/></geometry>
    </collision>
  </link>

  <link name="battery">
    <visual>
      <geometry><box size="0.076 0.140 0.076"/></geometry>
      <material name="battery_orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="1.36"/>
      <inertia ixx="2.876e-03" ixy="0" ixz="0"
               iyy="1.309e-03" iyz="0" izz="2.876e-03"/>
    </inertial>
    <collision>
      <geometry><box size="0.076 0.140 0.076"/></geometry>
    </collision>
  </link>

  <xacro:wheel name="w1"/>
  <xacro:wheel name="w2"/>
  <xacro:wheel name="w3"/>
  <xacro:wheel name="w4"/>
  <xacro:side_panel name="left_panel"/>
  <xacro:side_panel name="right_panel"/>

  <!-- =========================================================== -->
  <!--  JOINTS                                                      -->
  <!-- =========================================================== -->

  <!-- base_footprint → base_link: wheels at z=0 rel to base_link,
       spawn at z=0.036 so wheel bottoms touch ground -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.036" rpy="0 0 0"/>
  </joint>

  <joint name="j2" type="fixed">
    <parent link="base_link"/>
    <child  link="left_panel"/>
    <origin xyz="0 0.0735 0.018" rpy="1.5708 0 0"/>
  </joint>

  <joint name="j3" type="fixed">
    <parent link="base_link"/>
    <child  link="right_panel"/>
    <origin xyz="0 -0.0735 0.018" rpy="1.5708 0 0"/>
  </joint>

  <joint name="j4" type="fixed">
    <parent link="base_link"/>
    <child  link="battery"/>
    <origin xyz="0 0 0.039" rpy="0 0 0"/>
  </joint>

  <joint name="r1" type="continuous">
    <parent link="base_link"/>
    <child  link="w1"/>
    <origin xyz=" 0.0775 -0.083 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="r2" type="continuous">
    <parent link="base_link"/>
    <child  link="w2"/>
    <origin xyz="-0.0775 -0.083 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="r3" type="continuous">
    <parent link="base_link"/>
    <child  link="w3"/>
    <origin xyz="-0.0775  0.083 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="r4" type="continuous">
    <parent link="base_link"/>
    <child  link="w4"/>
    <origin xyz=" 0.0775  0.083 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- =========================================================== -->
  <!--  GAZEBO                                                      -->
  <!-- =========================================================== -->

  <gazebo reference="base_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="battery">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!--
    gz-sim-diff-drive-system: Gazebo Harmonic native plugin.
    Directly drives wheel joints in physics — no gz_ros2_control needed.
    Topics are Gazebo-internal; bridged to ROS2 via gazebo.launch.py.
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>r3</left_joint>
      <left_joint>r4</left_joint>
      <right_joint>r1</right_joint>
      <right_joint>r2</right_joint>
      <wheel_separation>0.166</wheel_separation>
      <wheel_radius>0.036</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/diff_drive_controller/cmd_vel</topic>
      <odom_topic>/diff_drive_controller/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
    </plugin>
  </gazebo>

  <!--
    gz-sim-joint-state-publisher: publishes /joint_states from Gazebo.
    Replaces joint_state_broadcaster (no gz_ros2_control needed).
  -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>r1</joint_name>
      <joint_name>r2</joint_name>
      <joint_name>r3</joint_name>
      <joint_name>r4</joint_name>
    </plugin>
  </gazebo>

</robot>
